diff --git a/src/markdown/obsidian-embeds.ts b/src/markdown/obsidian-embeds.ts
new file mode 100644
index 0000000000000000000000000000000000000000..863dbaa630a93a25d0b3aa613db0fff091432277
--- /dev/null
+++ b/src/markdown/obsidian-embeds.ts
@@ -0,0 +1,30 @@
+// [site patch] Obsidian 이미지 임베드 `![[파일.png]]`, `![[파일.png|설명]]`, `![[파일.png|300]]`
+// → 마크다운 이미지 `![설명](./images/파일.png)`. 위키링크 플러그인보다 먼저 실행해야 한다.
+type Node = any;
+const IMAGE_EXT = /\.(png|jpe?g|gif|webp|avif|svg)$/i;
+const EMBED = /!\[\[([^\]|\n]+?)(?:\|([^\]\n]*))?\]\]/g;
+const ATTACHMENT_DIR = "./images/";
+
+export const obsidianEmbedsPlugin = {
+  name: "site-obsidian-embeds",
+  text(node: Node, ctx: Node) {
+    const value: string = node.value;
+    if (!value.includes("![[")) return;
+    const out: Node[] = [];
+    let last = 0;
+    for (const m of value.matchAll(EMBED)) {
+      const [whole, rawTarget, rawLabel] = m;
+      const target = rawTarget.trim();
+      if (!IMAGE_EXT.test(target)) continue;
+      if (m.index! > last) out.push({ type: "text", value: value.slice(last, m.index) });
+      last = m.index! + whole.length;
+      const file = target.split("/").pop()!;
+      const label = rawLabel && !/^\s*\d+(x\d+)?\s*$/.test(rawLabel) ? rawLabel.trim() : "";
+      out.push({ type: "image", url: ATTACHMENT_DIR + encodeURI(file), alt: label, title: null });
+    }
+    if (!out.length) return;
+    if (last < value.length) out.push({ type: "text", value: value.slice(last) });
+    ctx.insertBefore(node, out);
+    ctx.removeNode(node);
+  },
+};
